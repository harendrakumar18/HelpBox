# Copy to .env for local development. Never commit .env.

# Instance & Deployment Identification
HELPBOX_INSTANCE_NAME=helpbox
COMPOSE_PROJECT_NAME=helpbox
POSTGRES_CONTAINER_NAME=helpbox-postgres
POSTGRES_HOST_PORT=5432
POSTGRES_VOLUME_NAME=helpbox_postgres_data
APP_PORT=8000

# Folder containing one direct subfolder per trial.
TRIALS_DIR=./data/trials

# PostgreSQL + pgvector (Local Docker container).
POSTGRES_DB=helpbox
POSTGRES_USER=helpbox
POSTGRES_PASSWORD=change_this_local_dev_password
DATABASE_URL=postgresql+psycopg://helpbox:change_this_local_dev_password@localhost:5432/helpbox

# Primary Embedding Model (768 dimensions)
EMBEDDING_MODEL=NeuML/bioclinical-modernbert-base-embeddings
EMBEDDING_DIMENSION=768
# Fallback Embedding Model: NeuML/pubmedbert-base-embeddings-8M (768 dimensions, 31MB)

# LLM Generation Provider: 'ollama' (Default local) | 'gemini' (Optional cloud)
# Note: Zero paid OpenAI cloud dependencies. No OpenAI account required.
GENERATION_PROVIDER=ollama

# Ollama settings (Local development default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_CONTEXT_WINDOW=4096

# Gemini API settings (Optional external provider - user-configured)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# RAG & Chunking defaults (Docling HybridChunker: 700-900 tokens)
RETRIEVAL_TOP_K=4
CHUNK_TOKEN_SIZE=800
CHUNK_TOKEN_OVERLAP=100
OCR_ENABLED=true
TABLE_EXTRACTION_ENABLED=true
